#!/usr/bin/env bash
# shellcheck shell=bash

M2D_SCRIPT_DIRECTORY=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || exit 255
source "$M2D_SCRIPT_DIRECTORY/lib/bootstrap.sh" || exit 255

M2D_PROJECT_PATH="$M2D_SCRIPT_DIRECTORY"
M2D_ENV_FILE="$M2D_PROJECT_PATH/.env"

source "${M2D_LIBRARIES_ROOT}/commands.sh" || exit "${RC_ERROR}"
commands::run "$M2D_PROJECT_PATH" "$@" || exit "${RC_ERROR}"
